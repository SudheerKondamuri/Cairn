# Server-only configuration. Never prefix secrets with NEXT_PUBLIC_.
CAIRN_APP_ORIGIN=http://localhost:3000
CAIRN_API_URL=http://127.0.0.1:8080
CAIRN_API_KEY=replace-with-random-service-key
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Local development skips sign-in. Set hosted on public deployments.
CAIRN_ACCESS_MODE=local
