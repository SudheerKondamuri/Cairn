FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app

WORKDIR /app

COPY requirements.txt requirements-worker.txt ./
RUN pip install --no-cache-dir -r requirements-worker.txt

COPY api ./api
COPY core ./core
COPY guest ./guest
COPY scripts ./scripts

CMD ["python", "scripts/worker.py", "--upload-root", "/var/lib/cairn/uploads", "--output-dir", "/app/reports/investigations"]
